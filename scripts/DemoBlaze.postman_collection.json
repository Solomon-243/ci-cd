{
  "info": {
    "_postman_id": "demoblaze-fixed-full-flow",
    "name": "DemoBlaze FULL FIXED FLOW",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "item": [

    {
      "name": "1 - entries",
      "request": {
        "method": "GET",
        "url": "https://api.demoblaze.com/entries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Items exist', () => {",
              "    pm.expect(json.Items).to.be.an('array');",
              "    pm.expect(json.Items.length).to.be.greaterThan(0);",
              "});",
              "",
              "// store first product safely",
              "pm.environment.set('ID', json.Items[0].id);",
              "pm.environment.set('TITLE', json.Items[0].title);"
            ]
          }
        }
      ]
    },

    {
      "name": "2 - view product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"{{ID}}\"}"
        },
        "url": "https://api.demoblaze.com/view"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "",
              "const id = json.id;",
              "const title = json.title;",
              "",
              "pm.environment.set('ID', id);",
              "pm.environment.set('TITLE', title);",
              "",
              "pm.test('Valid product', () => {",
              "    pm.expect(id).to.exist;",
              "    pm.expect(title).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "3 - add to cart",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('USER_ID')) {",
              "    pm.environment.set('USER_ID', pm.variables.replaceIn('{{$randomUUID}}'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{ID}}\",\n  \"cookie\": \"user={{USER_ID}}\",\n  \"prod_id\": {{ID}},\n  \"flag\": false\n}"
        },
        "url": "https://api.demoblaze.com/addtocart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },

    {
      "name": "4 - view cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cookie\": \"user={{USER_ID}}\",\n  \"flag\": false\n}"
        },
        "url": "https://api.demoblaze.com/viewcart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Cart has items', () => {",
              "    pm.expect(json.Items).to.be.an('array');",
              "    pm.expect(json.Items.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test('Product ID matches', () => {",
              "    pm.expect(json.Items[0].prod_id).to.eql(parseInt(pm.environment.get('ID')));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
