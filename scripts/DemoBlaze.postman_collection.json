{
  "info": {
    "_postman_id": "fixed-demoblaze-collection",
    "name": "DemoBlaze Fixed Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - entries",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://api.demoblaze.com/entries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "pm.test('Items exist', () => {",
              "  pm.expect(json.Items).to.be.an('array');",
              "  pm.expect(json.Items.length).to.be.greaterThan(0);",
              "});",
              "",
              "// store first product",
              "pm.environment.set('ID', json.Items[0]._id || 1);",
              "pm.environment.set('TITLE', json.Items[0].name || '');"
            ]
          }
        }
      ]
    },

    {
      "name": "2 - view product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"{{ID}}\"}"
        },
        "url": "https://api.demoblaze.com/view"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "pm.environment.set('ID', json._id || json.id || {{ID}});",
              "pm.environment.set('TITLE', json.title || '');",
              "",
              "pm.test('Title exists', () => {",
              "  pm.expect(json.title).to.exist;",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "3 - add to cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{ID}}\",\n  \"cookie\": \"user={{USER_ID}}\",\n  \"prod_id\": {{ID}},\n  \"flag\": false\n}"
        },
        "url": "https://api.demoblaze.com/addtocart"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('USER_ID')) {",
              "  pm.environment.set('USER_ID', pm.variables.replaceIn('{{$randomUUID}}'));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },

    {
      "name": "4 - view cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cookie\": \"user={{USER_ID}}\",\n  \"flag\": false\n}"
        },
        "url": "https://api.demoblaze.com/viewcart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Cart has items', () => {",
              "  pm.expect(json.Items).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ],

  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// global setup if needed",
          "if (!pm.environment.get('USER_ID')) {",
          "  pm.environment.set('USER_ID', pm.variables.replaceIn('{{$randomUUID}}'));",
          "}"
        ]
      }
    }
  ]
}
